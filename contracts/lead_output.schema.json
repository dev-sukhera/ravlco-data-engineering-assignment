{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BPO Lead Output Contract v1.0.0",
  "description": "The interface the downstream contact centre consumes. Every record MUST carry a complete eligibility decision. Default disposition is INELIGIBLE.",
  "type": "object",
  "required": [
    "lead_id", "source_system", "source_record_id", "ingested_at",
    "incident_date", "jurisdiction",
    "eligibility_status", "reason_codes", "decision_lineage_id",
    "evaluated_at", "ruleset_version"
  ],
  "properties": {
    "lead_id":            { "type": "string", "description": "Surrogate. Never a natural key containing PII." },
    "source_system":      { "enum": ["MONTGOMERY_MD", "TXDOT_CRIS", "NHTSA_FARS", "OTHER"] },
    "source_record_id":   { "type": "string" },
    "ingested_at":        { "type": "string", "format": "date-time" },

    "incident_date":      { "type": "string", "format": "date" },
    "report_filing_date": { "type": ["string", "null"], "format": "date" },
    "jurisdiction":       { "type": "string", "pattern": "^[A-Z]{2}$" },

    "geo": {
      "type": "object",
      "properties": {
        "zip5":            { "type": ["string","null"], "pattern": "^[0-9]{5}$",
                             "description": "ZIP5 is expressly excluded from DPPA 'personal information' at 18 U.S.C. 2725(3)." },
        "census_tract":    { "type": ["string","null"] },
        "census_bg":       { "type": ["string","null"] },
        "h3_r8":           { "type": ["string","null"] },
        "iana_timezone":   { "type": ["string","null"],
                             "description": "Derived from coordinates. NOT from area code, NOT from state." },
        "road_class":      { "type": ["string","null"] },
        "snap_distance_m": { "type": ["number","null"] }
      }
    },

    "severity_ordinal":   { "type": ["integer","null"], "minimum": 0, "maximum": 5 },

    "contact": {
      "type": "object",
      "description": "Tokenised. Direct identifiers live in the vault, not here.",
      "properties": {
        "phone_token":     { "type": ["string","null"] },
        "line_type":       { "enum": ["wireless", "landline", "voip", "unknown", null],
                             "description": "voip and unknown route to the MOST restrictive treatment." },
        "line_type_asof":  { "type": ["string","null"], "format": "date-time" },
        "dnc_scrub_asof":  { "type": ["string","null"], "format": "date-time",
                             "description": "Must be <= 31 days old at dial time. 16 C.F.R. 310.4(b)(3)(iv)." },
        "rnd_response":    { "enum": ["NO", "YES", "NO_DATA", null],
                             "description": "Safe harbour attaches ONLY to NO. NO_DATA is not a green light." },
        "calling_window_local": {
          "type": ["object","null"],
          "properties": {
            "earliest": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
            "latest":   { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$" },
            "basis":    { "type": "string" }
          }
        }
      }
    },

    "consent": {
      "type": ["object","null"],
      "properties": {
        "obtained_at":     { "type": "string", "format": "date-time" },
        "disclosure_hash": { "type": "string" },
        "disclosure_url":  { "type": "string" },
        "ip_address":      { "type": "string" },
        "user_agent":      { "type": "string" },
        "sellers_named":   { "type": "array", "items": { "type": "string" } },
        "source_chain":    { "type": "array", "items": { "type": "string" } },
        "revoked_at":      { "type": ["string","null"], "format": "date-time" }
      }
    },

    "eligibility_status": { "enum": ["ELIGIBLE", "INELIGIBLE", "BLOCKED_UNTIL"],
                            "default": "INELIGIBLE" },
    "blocked_until_date": { "type": ["string","null"], "format": "date" },
    "reason_codes":       { "type": "array", "minItems": 1,
                            "items": { "type": "string" },
                            "description": "Ordered by severity. See src/compliance/reason_codes.py" },
    "legal_basis":        { "type": "array", "items": { "type": "string" } },
    "decision_lineage_id":{ "type": "string" },
    "evaluated_at":       { "type": "string", "format": "date-time" },
    "ruleset_version":    { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },

    "priority_score":     { "type": ["number","null"] },
    "score_components":   { "type": ["object","null"],
                            "description": "Named contributions. No opaque blob." }
  }
}
