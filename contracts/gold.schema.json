{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/gold.schema.json",
  "title": "Gold layer contracts",
  "description": "One entry per gold table, same dialect as bronze/silver/lead_output. Row shape in `properties`; grain, referential integrity and the row-count floor in `x-table-constraints`. No `orphans_allowed_when` anywhere in gold: every dimension has an explicit UNKNOWN member, so a missing parent is always a bug. Phase 4 adds gold.crash_geo (one row per crash_sk, the geospatial enrichment) and gold.dim_block_group; crash_geo is written as GeoParquet 1.1.0 with a bbox covering column, so its `geometry` column is WKB and validates as a string.",
  "tables": {
    "gold.fact_crash": {
      "title": "Crash fact",
      "description": "One row per RESOLVED crash. The natural key is the primary source record's (source_system, source_record_id); crash_sk is a 60-bit SHA-256 of primary_crash_uid, deterministic and stable under restatement and under a FARS match being found or lost. Severity is the max across linked sources (severity_grain RESOLVED_MAX when they disagree); severity_ordinal_primary keeps the primary's own value. Counts come from party rows for Montgomery/FARS and from CRIS crash-level counts for TxDOT (count_source). Every *_sk is NOT NULL: dimensions carry a -1 UNKNOWN member.",
      "type": "object",
      "additionalProperties": false,
      "x-column-order-is-contract": true,
      "required": [
        "crash_sk",
        "primary_crash_uid",
        "primary_source_system",
        "natural_key",
        "jurisdiction",
        "date_sk",
        "time_sk",
        "crash_date",
        "geography_sk",
        "road_class_sk",
        "weather_condition_sk",
        "severity_sk",
        "severity_ordinal",
        "severity_ordinal_primary",
        "severity_grain",
        "geo_quality",
        "source_count",
        "in_montgomery",
        "in_txdot",
        "in_fars",
        "count_source",
        "silver_version_no",
        "silver_valid_from",
        "_silver_build_sha"
      ],
      "properties": {
        "crash_sk": {
          "type": "integer"
        },
        "primary_crash_uid": {
          "type": "string",
          "pattern": "^(MONTGOMERY_MD|TXDOT_CRIS|NHTSA_FARS):.+$"
        },
        "primary_source_system": {
          "type": "string",
          "enum": [
            "MONTGOMERY_MD",
            "TXDOT_CRIS",
            "NHTSA_FARS"
          ]
        },
        "natural_key": {
          "type": "string"
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "date_sk": {
          "type": "integer",
          "minimum": 19000101
        },
        "time_sk": {
          "type": "integer",
          "minimum": -1,
          "maximum": 2359
        },
        "crash_date": {
          "type": "date"
        },
        "crash_datetime_local": {
          "type": [
            "timestamp",
            "null"
          ]
        },
        "geography_sk": {
          "type": "integer"
        },
        "road_class_sk": {
          "type": "integer"
        },
        "weather_condition_sk": {
          "type": "integer"
        },
        "severity_sk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "severity_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "severity_ordinal_primary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "severity_grain": {
          "type": "string",
          "enum": [
            "MAX_OVER_PARTIES",
            "CRASH_REPORT_TYPE",
            "SOURCE_CRASH_LEVEL",
            "FATALITY_CENSUS",
            "RESOLVED_MAX"
          ]
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "geo_quality": {
          "type": "string",
          "enum": [
            "OK",
            "OUT_OF_ENVELOPE",
            "SENTINEL",
            "MISSING"
          ]
        },
        "source_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "in_montgomery": {
          "type": "boolean"
        },
        "in_txdot": {
          "type": "boolean"
        },
        "in_fars": {
          "type": "boolean"
        },
        "driver_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "non_motorist_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "vehicle_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "fatal_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "serious_injury_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "minor_injury_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "possible_injury_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "count_source": {
          "type": "string",
          "enum": [
            "PARTY_ROWS",
            "CRIS_COUNTS"
          ]
        },
        "fars_fatal_count": {
          "type": [
            "integer",
            "null"
          ]
        },
        "hit_run": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "pedestrian_involved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "bicyclist_involved": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "work_zone": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "intersection_related": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "alcohol_suspected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "drug_suspected": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "is_amended": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "silver_version_no": {
          "type": "integer",
          "minimum": 1
        },
        "silver_valid_from": {
          "type": "string"
        },
        "_silver_build_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "x-table-constraints": {
        "unique_keys": [
          [
            "crash_sk"
          ],
          [
            "primary_crash_uid"
          ]
        ],
        "foreign_keys": [
          {
            "columns": [
              "date_sk"
            ],
            "references": {
              "table": "gold.dim_date",
              "columns": [
                "date_sk"
              ]
            }
          },
          {
            "columns": [
              "time_sk"
            ],
            "references": {
              "table": "gold.dim_time",
              "columns": [
                "time_sk"
              ]
            }
          },
          {
            "columns": [
              "geography_sk"
            ],
            "references": {
              "table": "gold.dim_geography",
              "columns": [
                "geography_sk"
              ]
            }
          },
          {
            "columns": [
              "road_class_sk"
            ],
            "references": {
              "table": "gold.dim_road_class",
              "columns": [
                "road_class_sk"
              ]
            }
          },
          {
            "columns": [
              "weather_condition_sk"
            ],
            "references": {
              "table": "gold.dim_weather_condition",
              "columns": [
                "weather_condition_sk"
              ]
            }
          },
          {
            "columns": [
              "severity_sk"
            ],
            "references": {
              "table": "gold.dim_severity",
              "columns": [
                "severity_sk"
              ]
            }
          },
          {
            "columns": [
              "crash_sk"
            ],
            "references": {
              "table": "gold.bridge_crash_source",
              "columns": [
                "crash_sk"
              ]
            },
            "description": "Every resolved crash has at least its primary row in the bridge."
          }
        ],
        "row_count_min": 200000
      }
    },
    "gold.bridge_crash_source": {
      "title": "Crash-to-source bridge",
      "description": "One row per (resolved crash, contributing silver.crash record). Every in-scope silver crash_uid appears exactly once -- that is the silver-to-gold reconciliation. is_primary marks the record whose key the fact carries; matched FARS rows carry the tier, distance and time delta of the match.",
      "type": "object",
      "additionalProperties": false,
      "x-column-order-is-contract": true,
      "required": [
        "crash_sk",
        "crash_uid",
        "source_system",
        "source_record_id",
        "is_primary",
        "match_method"
      ],
      "properties": {
        "crash_sk": {
          "type": "integer"
        },
        "crash_uid": {
          "type": "string",
          "pattern": "^(MONTGOMERY_MD|TXDOT_CRIS|NHTSA_FARS):.+$"
        },
        "source_system": {
          "type": "string",
          "enum": [
            "MONTGOMERY_MD",
            "TXDOT_CRIS",
            "NHTSA_FARS"
          ]
        },
        "source_record_id": {
          "type": "string"
        },
        "is_primary": {
          "type": "boolean"
        },
        "match_method": {
          "type": "string",
          "enum": [
            "SINGLE_SOURCE",
            "PRIMARY_OF_MATCH",
            "FATAL_DATE_GEO_TIME_A",
            "FATAL_DATE_GEO_TIME_B",
            "FATAL_DATE_COUNTY_TIME"
          ]
        },
        "match_tier": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "A",
            "B",
            "C"
          ]
        },
        "dist_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "time_delta_min": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "date_delta_days": {
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "x-table-constraints": {
        "unique_keys": [
          [
            "crash_uid"
          ],
          [
            "crash_sk",
            "crash_uid"
          ]
        ],
        "foreign_keys": [
          {
            "columns": [
              "crash_sk"
            ],
            "references": {
              "table": "gold.fact_crash",
              "columns": [
                "crash_sk"
              ]
            },
            "description": "Every bridge row -- primary or matched FARS -- hangs off a fact row."
          }
        ],
        "row_count_min": 200000
      }
    },
    "gold.fact_driver": {
      "title": "Driver fact",
      "description": "One row per driver: Montgomery driver rows (person_id) and FARS persons with PER_TYP 1. TxDOT publishes no person rows, so it contributes none by construction. crash_sk is the RESOLVED crash, so a FARS driver on a matched Montgomery crash points at the Montgomery key.",
      "type": "object",
      "additionalProperties": false,
      "x-column-order-is-contract": true,
      "required": [
        "driver_sk",
        "crash_sk",
        "crash_uid",
        "source_system",
        "party_natural_key",
        "date_sk",
        "severity_sk",
        "severity_ordinal",
        "alcohol_status",
        "drug_status",
        "silver_version_no",
        "silver_valid_from"
      ],
      "properties": {
        "driver_sk": {
          "type": "integer"
        },
        "crash_sk": {
          "type": "integer"
        },
        "crash_uid": {
          "type": "string"
        },
        "source_system": {
          "type": "string",
          "enum": [
            "MONTGOMERY_MD",
            "NHTSA_FARS"
          ]
        },
        "party_natural_key": {
          "type": "string"
        },
        "date_sk": {
          "type": "integer"
        },
        "severity_sk": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "severity_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "severity_kabco": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "K",
            "A",
            "B",
            "C",
            "O"
          ]
        },
        "severity_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "age": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 120
        },
        "alcohol_status": {
          "type": "string",
          "enum": [
            "NOT_SUSPECTED",
            "SUSPECTED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "drug_status": {
          "type": "string",
          "enum": [
            "NOT_SUSPECTED",
            "SUSPECTED",
            "UNKNOWN",
            "NOT_APPLICABLE"
          ]
        },
        "at_fault": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "vehicle_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "vehicle_make": {
          "type": [
            "string",
            "null"
          ]
        },
        "vehicle_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "vehicle_body_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "speed_limit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "licence_state": {
          "type": [
