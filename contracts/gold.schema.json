        "row_count_min": 1441
      }
    },
    "gold.dim_geography": {
      "title": "Geography dimension",
      "description": "Every county in the in-scope states (Census 2020 county list, config/counties.csv) with geography_sk = county GEOID, one STATE-level member per jurisdiction (sk = state FIPS) for rows whose county is unknown, and -1 UNKNOWN. Phase 4 hangs tract / block group / H3 off this.",
      "type": "object",
      "additionalProperties": false,
      "x-column-order-is-contract": true,
      "required": [
        "geography_sk",
        "level"
      ],
      "properties": {
        "geography_sk": {
          "type": "integer"
        },
        "level": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "STATE",
            "COUNTY"
