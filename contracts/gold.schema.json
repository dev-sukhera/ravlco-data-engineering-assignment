            "null"
          ]
        },
        "silver_version_no": {
          "type": "integer",
          "minimum": 1
        },
        "silver_valid_from": {
          "type": "string"
        }
      },
      "x-table-constraints": {
        "unique_keys": [
          [
            "driver_sk"
          ],
          [
            "source_system",
            "party_natural_key"
          ]
        ],
        "foreign_keys": [
          {
            "columns": [
              "crash_sk"
            ],
            "references": {
              "table": "gold.fact_crash",
              "columns": [
                "crash_sk"
              ]
            }
          },
          {
            "columns": [
              "crash_uid"
            ],
            "references": {
              "table": "gold.bridge_crash_source",
              "columns": [
                "crash_uid"
              ]
            }
          },
          {
            "columns": [
              "date_sk"
            ],
            "references": {
              "table": "gold.dim_date",
              "columns": [
                "date_sk"
              ]
            }
          },
          {
            "columns": [
              "severity_sk"
            ],
            "references": {
              "table": "gold.dim_severity",
              "columns": [
                "severity_sk"
              ]
            }
          }
        ],
        "row_count_min": 200000
      }
    },
