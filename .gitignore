# Local config — candidates copy settings.example.toml and add their own keys
config/settings.toml
.env
*.key

# Data — never commit source extracts or derived layers
data/
*.parquet
*.pbf
*.zip
*.duckdb
*.sqlite
bronze/
silver/
gold/

# ...except the committed test extracts. These are a few hundred real bronze
# rows per table (948 KB total, no PII -- public crash records with opaque
# party GUIDs), in the exact bronze format, so the defect tests run without
# data/ present. Generated by tests/fixtures/make_extracts.py.
!tests/fixtures/bronze/
!tests/fixtures/bronze/**

# Python
.venv/
.dagster/
dagster_home/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/
